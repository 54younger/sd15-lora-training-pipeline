# Replace the sample tokens before exposing the API beyond localhost.
LORA_API_KEYS={"replace-with-long-random-token":"owner-a"}
LORA_ADMIN_KEYS=["replace-with-long-random-token"]
LORA_TEST_BACKEND=1
LORA_FAKE_SLOTS=1
# Real GPU override: TEST_BACKEND=0, FAKE_SLOTS=0; optional UUID allowlist.
LORA_GPU_UUIDS=
# Browser entry point. Keep the default loopback bind for a local installation.
LORA_WEB_BIND=127.0.0.1
LORA_WEB_PORT=8080
# Optional Hugging Face token for model downloads; passed only to the worker.
HF_TOKEN=
